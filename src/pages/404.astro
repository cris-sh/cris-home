---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { locales, ui, useTranslations } from '../i18n/ui';

const title = { en: ui.en['notFound.title'], es: ui.es['notFound.title'] };
const description = { en: ui.en['notFound.body'], es: ui.es['notFound.body'] };
---

<Base title={title} description={description} noindex>
	{
		locales.map((locale) => {
			const t = useTranslations(locale);
			return (
				<div data-locale={locale} lang={locale} class="intro">
					<h1 class="display">{t('notFound.title')}</h1>
					<p class="lede not-found-body">{t('notFound.body')}</p>
					<p class="actions">
						<a class="button" href="/">
							<Arrow direction="back" />
							{t('notFound.back')}
						</a>
					</p>
				</div>
			);
		})
	}
</Base>

<style>
	.not-found-body {
		margin-top: 0.75rem;
	}
</style>
