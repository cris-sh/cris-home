---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Arrow from './Arrow.astro';
import BrandIcon from './BrandIcon.astro';
import More from './More.astro';
import T from './T.astro';
import portrait from '../assets/portrait.jpg';
import { education, experience, person, socials } from '../data/profile';
import { formatDate, formatMonth, locales, useTranslations } from '../i18n/ui';

// Sections exist once (so `#projects` and `#contact` are real anchors); only the
// copy inside them is rendered per language.
const allProjects = (await getCollection('projects')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const projectsFor = (locale: string) => allProjects.filter((project) => project.id.startsWith(`${locale}/`));
---

<div class="stack intro">
	<header class="hero">
		<div class="avatar">
			<Image src={portrait} alt="" width={64} height={64} layout="fixed" loading="eager" />
		</div>
		<div>
			<h1 class="display">{person.name}</h1>
			<p>
				{
					locales.map((locale) => {
						const t = useTranslations(locale);
						return (
							<span data-locale={locale} lang={locale}>
								{t('hero.role')} · {t('hero.location')}
							</span>
						);
					})
				}
			</p>
		</div>
	</header>

	<section class="about">
		{
			locales.map((locale) => {
				const t = useTranslations(locale);
				return (
					<div data-locale={locale} lang={locale}>
						<p>{t('about.p1')}</p>
						<More id={`about-more-${locale}`} locale={locale}>
							<p>{t('about.p2')}</p>
						</More>
					</div>
				);
			})
		}
	</section>

	<section id="experience">
		<h2 class="section-label"><T k="section.experience" /></h2>
		{
			experience.map((job, index) => (
				<article class="job">
					<div class="entry-head">
						<span class="entry-logo">
							<Image src={job.logo} alt="" width={40} height={40} layout="fixed" />
						</span>
						<div class="entry-id">
							<h3 class="entry-title">{job.company}</h3>
							<p class="entry-sub">
								{locales.map((locale) => (
									<span data-locale={locale} lang={locale}>
										{job.role[locale]}
									</span>
								))}
							</p>
						</div>
						<p class="entry-meta tabular">
							{locales.map((locale) => (
								<span data-locale={locale} lang={locale}>
									<span class="entry-dates">
										<time datetime={job.start}>{formatMonth(job.start, locale)}</time> –{' '}
										<time datetime={job.end}>{formatMonth(job.end, locale)}</time>
									</span>
									<span class="entry-place">
										{job.place[locale]} · {job.mode[locale]}
									</span>
								</span>
							))}
						</p>
					</div>
					{locales.map((locale) => (
						<div class="entry-body entry-text" data-locale={locale} lang={locale}>
							<p>{`${job.highlights[locale][0]} `}</p>
							{job.highlights[locale].length > 1 && (
								<More id={`job-more-${index}-${locale}`} locale={locale}>
									<p>{job.highlights[locale].slice(1).join(' ')}</p>
								</More>
							)}
						</div>
					))}
					{job.stack && job.stack.length > 0 && (
						<ul class="chips chips-scroll">
							{job.stack.map((name) => (
								<li class="chip">
									<BrandIcon name={name} />
									{name}
								</li>
							))}
						</ul>
					)}
				</article>
			))
		}
	</section>

	{
		allProjects.length > 0 && (
			<section id="projects">
				<h2 class="section-label">
					<T k="section.projects" />
				</h2>
				{locales.map((locale) => {
					const t = useTranslations(locale);
					return (
						<ul class="rows" data-locale={locale} lang={locale}>
							{projectsFor(locale).map((project) => (
								<li>
									<a class="row row-project" href={`/projects/${project.id.split('/')[1]}/`}>
										<span class="row-main">
											<span class="row-heading">
												<span class="row-title" data-project-title>
													{project.data.title}
												</span>
												{project.data.status === 'in-progress' && <span class="badge">{t('project.in-progress')}</span>}
											</span>
											<span class="row-desc">{project.data.description}</span>
										</span>
										<time class="row-meta tabular" datetime={project.data.date.toISOString().slice(0, 10)}>
											{formatDate(project.data.date, locale)}
										</time>
									</a>
								</li>
							))}
						</ul>
					);
				})}
			</section>
		)
	}

	<section id="education">
		<h2 class="section-label"><T k="section.education" /></h2>
		{
			education.map((item) => (
				<article>
					<div class="entry-head">
						<h3 class="entry-title">{item.school}</h3>
						<p class="entry-meta tabular">
							{locales.map((locale) => (
								<span data-locale={locale} lang={locale}>
									<time datetime={item.start}>{formatMonth(item.start, locale)}</time> –{' '}
									<time datetime={item.end}>{formatMonth(item.end, locale)}</time>
								</span>
							))}
						</p>
					</div>
					<p class="entry-sub">
						{locales.map((locale) => (
							<span data-locale={locale} lang={locale}>
								{item.degree[locale]}
							</span>
						))}
					</p>
				</article>
			))
		}
	</section>

	<section id="contact">
		<h2 class="section-label"><T k="section.contact" /></h2>
		<ul class="rows">
			<li>
				<a class="row row-contact" href="/cv/">
					<span class="row-icon">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path>
							<path d="M14 3v5h5M9 13h6M9 17h6"></path>
						</svg>
					</span>
					<span class="row-main"><T k="cv.title" /></span>
					<span class="row-meta"><T k="contact.resumeMeta" /></span>
				</a>
			</li>
			<li>
				<a class="row row-contact" href={`mailto:${person.email}`}>
					<span class="row-icon">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<rect x="3" y="5" width="18" height="14" rx="2"></rect>
							<path d="m3 7 9 6 9-6"></path>
						</svg>
					</span>
					<span class="row-main"><T k="contact.email" /></span>
					<span class="row-meta">{person.email}</span>
				</a>
			</li>
			{
				socials.map((social) => (
					<li>
						<a class="row row-contact" href={social.href} target="_blank" rel="noopener noreferrer">
							<span class="row-icon">
								<BrandIcon name={social.brand} />
							</span>
							<span class="row-main">{social.brand}</span>
							<span class="row-meta">{social.handle}</span>
							<Arrow />
							<span class="sr-only">
								(<T k="a11y.external" />)
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</div>
