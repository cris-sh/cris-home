---
import T from './T.astro';
---

{/* One viewer per page, shared by every thumbnail. Native <dialog>: focus trap, Escape and inert background for free. */}
<dialog class="lightbox" aria-labelledby="lightbox-label">
	<h2 id="lightbox-label" class="sr-only"><T k="a11y.viewer" /></h2>
	<div class="lightbox-scrim"></div>
	<img class="lightbox-img" alt="" draggable="false" />
	<button class="lightbox-close" type="button">
		<span class="sr-only"><T k="a11y.close" /></span>
		<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
			<path d="m4 4 8 8M12 4l-8 8"></path>
		</svg>
	</button>
</dialog>

<script>
	import '../scripts/lightbox.ts';
</script>
